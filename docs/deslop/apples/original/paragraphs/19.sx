entity apple object it "the apple" generic
entity varieties object they "less commercially successful varieties"
entity wild object they "wild apple populations"
topic t1 "why preserve varieties" varieties
(S%t1
  (S.csubj Preserving/VERB.head=preserve{Ger}
     (NP.obj@varieties (ADJP.amod less/ADV.advmod commercially/ADV.advmod successful/ADJ.head) varieties/NOUN.head))
  (VP.head is/AUX.cop=be{Fin,Pres} important/ADJ.head
     (SBAR.advcl because/SCONJ.mark
        (S.head (NP.nsubj@varieties they/PRON.head)
           (VP.head may/AUX.aux contain/VERB.head{Inf}
              (NP.obj genetic/ADJ.amod traits/NOUN.head
                 (ADJP.amod useful/ADJ.head (PP.obl for/ADP.case future/ADJ.amod breeding/NOUN.head)))))))
  ./PUNCT)
(S%t1
  (NP.nsubj@wild Wild/ADJ.amod apple/NOUN.compound populations/NOUN.head)
  (VP.head are/AUX.cop=be{Fin,Pres}
     (NP.head (ADJP.amod particularly/ADV.advmod valuable/ADJ.head) reservoirs/NOUN.head
        (PP.nmod of/ADP.case
           (COORD.head (NP.conj resistance/NOUN.head (PP.nmod to/ADP.case diseases/NOUN.head)) and/CCONJ.cc
              (NP.conj tolerance/NOUN.head (PP.nmod of/ADP.case environmental/ADJ.amod stress/NOUN.head))))))
  ./PUNCT)
