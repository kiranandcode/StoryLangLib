  (VP.head usually/ADV.advmod showed/VERB.head=show{Fin,Past}
     (NP.obj@fruit the/DET.det forbidden/ADJ.amod fruit/NOUN.head (PP.nmod of/ADP.case Eden/PROPN.head))
