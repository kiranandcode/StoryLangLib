entity apple object it "the apple" generic
entity trees object they "apple trees"
entity regions place they "established growing regions"
topic t1 "climate" trees
(S%t1
  (NP.nsubj@trees Apple/NOUN.compound trees/NOUN.head)
  (VP.head need/VERB.head{Fin,Pres}
     (NP.obj particular/ADJ.amod temperatures/NOUN.head)
     (VP.advcl to/PART.mark
        (COORD.head (VP.conj flower/VERB.head{Inf}) and/CCONJ.cc (VP.conj set/VERB.head{Inf} (NP.obj fruit/NOUN.head)))))
  ./PUNCT)
(S%t1
  (SBAR.advcl As/SCONJ.mark
     (S.head (NP.nsubj the/DET.det climate/NOUN.head) (VP.head changes/VERB.head=change{Fin,Pres})))
  ,/PUNCT
  (NP.nsubj shifts/NOUN.head
     (PP.nmod in/ADP.case
        (COORD.head (NP.conj winter/NOUN.compound temperatures/NOUN.head) ,/PUNCT (NP.conj spring/NOUN.compound frosts/NOUN.head) and/CCONJ.cc rainfall/NOUN.conj)))
  (VP.head may/AUX.aux make/VERB.head{Inf}
     (NP.obj@regions some/DET.det established/ADJ.amod growing/NOUN.compound regions/NOUN.head)
     (ADJP.xcomp less/ADV.advmod suitable/ADJ.head (PP.obl for/ADP.case them/PRON.head@trees)))
  ./PUNCT)
