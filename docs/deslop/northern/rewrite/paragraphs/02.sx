entity article object it "the article"
entity movement group it "the Northern English movement"
entity movements group they "movements" generic
topic t1 "the movement exists" movement
(S%t1
  (NP.nsubj The/DET.det article's/NOUN.poss@article subject/NOUN.head)
  (VP.head is/AUX.cop=be{Fin,Pres}
     (NP.head@movement a/DET.det (ADJP.amod visible/ADJ.conj and/CCONJ.cc growing/ADJ.conj) movement/NOUN.head
        (PP.nmod around/ADP.case Northern/ADJ.amod English/ADJ.amod identity/NOUN.head)))
  ./PUNCT)
(S%t1
  (COORD.nsubj (NP.conj Academic/ADJ.amod literature/NOUN.head) ,/PUNCT (NP.conj social/ADJ.amod media/NOUN.head) and/CCONJ.cc
     (NP.conj grassroots/NOUN.compound activism/NOUN.head))
  (VP.head all/ADV.advmod document/VERB.head{Fin,Pres} (NP.obj@movement it/PRON.head))
  ./PUNCT)
(S%t1
  (NP.nsubj@movement The/DET.det movement/NOUN.head)
  (VP.head does/AUX.aux=do{Fin,Pres} not/PART.advmod always/ADV.advmod go/VERB.head{Inf}
     (PP.obl by/ADP.case the/DET.det name/NOUN.head
        (QUOTE.appos "/PUNCT Northern/ADJ.amod English/ADJ.amod nationalism/NOUN.head "/PUNCT)))
  ./PUNCT)
(S%t1
  (PP.obl@movements Like/ADP.case most/ADJ.amod movements/NOUN.head)
  ,/PUNCT
  (NP.nsubj@movement it/PRON.head)
  (VP.head took/VERB.head=take{Fin,Past} (NP.obj shape/NOUN.head)
     (SBAR.advcl before/SCONJ.mark
        (S.head (NP.nsubj anyone/PRON.head)
           (VP.head settled/VERB.head=settle{Fin,Past}
              (PP.obl on/ADP.case a/DET.det name/NOUN.head (PP.nmod for/ADP.case it/PRON.head@movement))))))
  ./PUNCT)
