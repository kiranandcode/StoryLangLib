import LangLib.World.Examples.Fight

/-!
# Generator for `FightSnaps.lean` (not part of the library build)

Prints `FightSnaps.lean`: the fight's state at the checkpoints (after
paragraphs 3, 6, 7 and 9) as `Snap` literals, and the theorems that they are
the states. Regenerate after changing the fight or the modules it uses:

```
lake env lean LangLib/World/Examples/FightSnapsGen.lean > LangLib/World/Examples/FightSnaps.lean
```

The literals are untrusted data: each checkpoint theorem re-derives its state
from the previous one by `decide +kernel`, so a stale file fails to build.
-/

open LangLib.World LangLib.World.Fight

def lit (s : Snap) : String := ((repr s).pretty 100000000).replace "LangLib.World.Fight." "" |>.replace "LangLib.World." ""

def s3 : Snap := snap (run start (p1 ++ p2 ++ p3))
def s6 : Snap := snap (run s3.toW (p4 ++ p5 ++ p6))
def s7 : Snap := snap (run s6.toW p7)
def s9 : Snap := snap (run s7.toW (p8 ++ p9))

#eval IO.print s!"import LangLib.World.Examples.Fight

/-!
# The fight's checkpoints: generated by `FightSnapsGen.lean`, do not edit

The state after paragraphs 3, 6, 7 and 9 as plain data. Each `atK` theorem
derives its state from the previous checkpoint by `decide +kernel`, so later
theorems start from a checkpoint instead of replaying the fight.
-/

namespace LangLib.World.Fight
open LangLib.World Ch Pl Ab

def s3 : Snap := {lit s3}

def s6 : Snap := {lit s6}

def s7 : Snap := {lit s7}

def s9 : Snap := {lit s9}

theorem snap3 : snap (run start (p1 ++ p2 ++ p3)) = s3 := by decide +kernel
theorem snap6 : snap (run s3.toW (p4 ++ p5 ++ p6)) = s6 := by decide +kernel
theorem snap7 : snap (run s6.toW p7) = s7 := by decide +kernel
theorem snap9 : snap (run s7.toW (p8 ++ p9)) = s9 := by decide +kernel

theorem at3 : run start (p1 ++ p2 ++ p3) = s3.toW := by rw [← snap3, toW_snap]
theorem at6 : run s3.toW (p4 ++ p5 ++ p6) = s6.toW := by rw [← snap6, toW_snap]
theorem at7 : run s6.toW p7 = s7.toW := by rw [← snap7, toW_snap]
theorem at9 : run s7.toW (p8 ++ p9) = s9.toW := by rw [← snap9, toW_snap]

theorem after3 : after 3 = s3.toW := by
  rw [← at3]; unfold after
  rw [show ([p1, p2, p3, p4, p5, p6, p7, p8, p9].take 3).flatten = p1 ++ p2 ++ p3 by decide +kernel]

theorem after6 : after 6 = s6.toW := by
  rw [← at6, ← at3, ← run_append]; unfold after
  rw [show ([p1, p2, p3, p4, p5, p6, p7, p8, p9].take 6).flatten = p1 ++ p2 ++ p3 ++ (p4 ++ p5 ++ p6) by
    decide +kernel]

theorem after7 : after 7 = s7.toW := by
  rw [← at7, ← at6, ← at3, ← run_append, ← run_append]; unfold after
  rw [show ([p1, p2, p3, p4, p5, p6, p7, p8, p9].take 7).flatten =
    p1 ++ p2 ++ p3 ++ (p4 ++ p5 ++ p6 ++ p7) by decide +kernel]

theorem ends9 : ends = s9.toW := by
  rw [← at9, ← at7, ← at6, ← at3, ← run_append, ← run_append, ← run_append]; unfold ends
  rw [show fight = p1 ++ p2 ++ p3 ++ (p4 ++ p5 ++ p6 ++ (p7 ++ (p8 ++ p9))) by
    decide +kernel]

end LangLib.World.Fight
"
