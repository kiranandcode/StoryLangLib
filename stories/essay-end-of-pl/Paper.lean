/-! EndOfPL: the argument of the excerpt, read paragraph by paragraph
(generated by tools/essay/argument_gen.py from argument.py). -/

namespace Essays.EndOfPL
open LangLib.World LangLib.World.Argument

inductive Tm
  | llms
  | pl_research
  | code
  | types_list
  | research
  | ego
  | exploration
  | practicalApps
  | applicationsMatter
  | plObsoleteFear
  | llmsAffectEnthusiasm
  | thread
  | majorityNegative
  | crisis
  | juniorsWorry
  | vision
  | excited
  | ideasPlentiful
  | explorationPremise
  | premiseArgued
  | llmsCodeWell
  | humansStopCoding
  | rebuttal
  | bridge
  | workOnIdeas
  | compromiseIdeas
  | seMessy
  | messNeeded
  | ideasRemain
  | fewUsers
  | biggerProblems
  | whyExcited
  | counterfactualsFast
  | newIdeasDaily
  | assumptionsUpturned
  | novelIdeas
  | llmsProve
  | verifyBinary
  | unthinkable
  | toolingHuman
  | llmsDiffer
  | toolingPossible
  | amazonExperiments
  | dynestyx
  | colleaguesPL
  | dynestyxUnifies
  | domainExpert
  | theoryToo
  | iterateFast
  | loss
  | craftPride
  | egoNotCuriosity
  | expertiseNotNeeded
  | explorationIsResearch
  | transformative
  deriving DecidableEq, Repr

def lore : List Tm := [Tm.llms, Tm.pl_research, Tm.code, Tm.types_list, Tm.research, Tm.ego, Tm.exploration]

/-- What the reader would infer: objections they would raise unprompted. -/
instance : Lore (AFact Tm) := ⟨[{ body := [(AFact.holds Tm.practicalApps, true)], head := (AFact.holds Tm.applicationsMatter, true) }, { body := [(AFact.holds Tm.plObsoleteFear, true)], head := (AFact.holds Tm.llmsAffectEnthusiasm, true) }]⟩

def w0 : AW Tm := start lore [0, 1, 2, 3]

def p01 : List (Move Tm) :=
  [Move.heading 0,
   Move.cite Tm.thread [Tm.types_list, Tm.llms]]

def p02 : List (Move Tm) :=
  [Move.claim Tm.majorityNegative [Tm.thread],
   Move.hedge Tm.crisis 0 [Tm.thread],
   Move.cite Tm.crisis [Tm.thread]]

def p03 : List (Move Tm) :=
  [Move.hedge Tm.juniorsWorry 0 [Tm.thread],
   Move.claim Tm.juniorsWorry [Tm.thread, Tm.pl_research],
   Move.promise Tm.vision 2 [Tm.juniorsWorry]]

def p04 : List (Move Tm) :=
  [Move.claim Tm.excited [Tm.research],
   Move.claim Tm.ideasPlentiful [Tm.research]]

def p05 : List (Move Tm) :=
  [Move.claim Tm.explorationPremise [Tm.ego, Tm.exploration],
   Move.contrast Tm.ego Tm.exploration [],
   Move.promise Tm.premiseArgued 3 [Tm.explorationPremise]]

def p06 : List (Move Tm) :=
  [Move.heading 1,
   Move.claim Tm.llmsCodeWell [Tm.llms, Tm.code],
   Move.infer Tm.humansStopCoding [Tm.llmsCodeWell] [Tm.code]]

def p07 : List (Move Tm) :=
  [Move.cite Tm.plObsoleteFear [Tm.humansStopCoding, Tm.pl_research]]

def p08 : List (Move Tm) :=
  [Move.motivate Tm.rebuttal [Tm.plObsoleteFear]]

def p09 : List (Move Tm) :=
  [Move.infer Tm.bridge [] [Tm.pl_research],
   Move.claim Tm.workOnIdeas [Tm.pl_research],
   Move.deny Tm.compromiseIdeas [Tm.workOnIdeas],
   Move.claim Tm.practicalApps [Tm.pl_research]]

def p10 : List (Move Tm) :=
  [Move.deny Tm.applicationsMatter [Tm.practicalApps],
   Move.claim Tm.seMessy [Tm.research],
   Move.claim Tm.messNeeded [Tm.seMessy]]

def p11 : List (Move Tm) :=
  [Move.claim Tm.ideasRemain [Tm.workOnIdeas],
   Move.claim Tm.fewUsers [Tm.code]]

def p12 : List (Move Tm) :=
  [Move.claim Tm.biggerProblems [Tm.llms, Tm.pl_research]]

def p13 : List (Move Tm) :=
  [Move.heading 2,
   Move.deliver Tm.vision [Tm.llms],
   Move.deny Tm.llmsAffectEnthusiasm [Tm.llms],
   Move.promise Tm.whyExcited 0 [Tm.llms]]

def p14 : List (Move Tm) :=
  [Move.hedge Tm.counterfactualsFast 0 [Tm.llms],
   Move.claim Tm.counterfactualsFast [Tm.llms, Tm.research],
   Move.deliver Tm.whyExcited [Tm.counterfactualsFast]]

def p15 : List (Move Tm) :=
  [Move.claim Tm.newIdeasDaily [Tm.research]]

def p16 : List (Move Tm) :=
  [Move.claim Tm.assumptionsUpturned [Tm.code],
   Move.claim Tm.novelIdeas [Tm.assumptionsUpturned]]

def p17 : List (Move Tm) :=
  [Move.claim Tm.llmsProve [Tm.llms],
   Move.claim Tm.verifyBinary [Tm.llmsProve],
   Move.«example» Tm.counterfactualsFast [Tm.llmsProve],
   Move.claim Tm.unthinkable [Tm.llmsProve]]

def p18 : List (Move Tm) :=
  [Move.claim Tm.toolingHuman [Tm.code],
   Move.claim Tm.llmsDiffer [Tm.llms],
   Move.hedge Tm.toolingPossible 0 [Tm.llmsDiffer],
   Move.infer Tm.toolingPossible [Tm.llmsDiffer] [Tm.toolingHuman],
   Move.claim Tm.amazonExperiments [Tm.toolingPossible]]

def p19 : List (Move Tm) :=
  [Move.claim Tm.dynestyx [Tm.research],
   Move.deny Tm.colleaguesPL [Tm.dynestyx],
   Move.claim Tm.dynestyxUnifies [Tm.dynestyx],
   Move.concede Tm.domainExpert [Tm.dynestyx],
   Move.«example» Tm.counterfactualsFast [Tm.dynestyx, Tm.llms]]

def p20 : List (Move Tm) :=
  [Move.claim Tm.theoryToo [Tm.llms, Tm.research],
   Move.«example» Tm.theoryToo [Tm.llms],
   Move.claim Tm.iterateFast [Tm.theoryToo]]

def p21 : List (Move Tm) :=
  [Move.hedge Tm.loss 0 [Tm.ego],
   Move.claim Tm.craftPride [Tm.code],
   Move.claim Tm.egoNotCuriosity [Tm.craftPride, Tm.ego],
   Move.claim Tm.expertiseNotNeeded [Tm.egoNotCuriosity, Tm.exploration]]

def p22 : List (Move Tm) :=
  [Move.heading 3,
   Move.deliver Tm.premiseArgued [Tm.egoNotCuriosity],
   Move.claim Tm.explorationIsResearch [Tm.exploration, Tm.research]]

def p23 : List (Move Tm) :=
  []

def p24 : List (Move Tm) :=
  [Move.claim Tm.transformative [Tm.pl_research]]

def moves : List (Move Tm) := p01 ++ p02 ++ p03 ++ p04 ++ p05 ++ p06 ++ p07 ++ p08 ++ p09 ++ p10 ++ p11 ++ p12 ++ p13 ++ p14 ++ p15 ++ p16 ++ p17 ++ p18 ++ p19 ++ p20 ++ p21 ++ p22 ++ p23 ++ p24

/-- No term is used before it is lore, defined or promised; promises point forward; deliveries pay off. -/
theorem valid : Valid w0 moves := by decide +kernel

/-- What the excerpt leaves unpaid. -/
theorem gaps_are : gapsOf (run w0 moves) =
    [Gap.unsupported Tm.majorityNegative,
     Gap.unsupported Tm.excited,
     Gap.unsupported Tm.ideasPlentiful,
     Gap.unsupported Tm.explorationPremise,
     Gap.unsupported Tm.llmsCodeWell,
     Gap.unsupported Tm.humansStopCoding,
     Gap.unsupported Tm.workOnIdeas,
     Gap.unsupported Tm.practicalApps,
     Gap.unsupported Tm.seMessy,
     Gap.unsupported Tm.messNeeded,
     Gap.unsupported Tm.ideasRemain,
     Gap.unsupported Tm.fewUsers,
     Gap.unsupported Tm.biggerProblems,
     Gap.unsupported Tm.newIdeasDaily,
     Gap.unsupported Tm.assumptionsUpturned,
     Gap.unsupported Tm.novelIdeas,
     Gap.unsupported Tm.llmsProve,
     Gap.unsupported Tm.verifyBinary,
     Gap.unsupported Tm.unthinkable,
     Gap.unsupported Tm.toolingHuman,
     Gap.unsupported Tm.llmsDiffer,
     Gap.unsupported Tm.amazonExperiments,
     Gap.unsupported Tm.dynestyx,
     Gap.unsupported Tm.dynestyxUnifies,
     Gap.unsupported Tm.iterateFast,
     Gap.unsupported Tm.craftPride,
     Gap.unsupported Tm.egoNotCuriosity,
     Gap.unsupported Tm.expertiseNotNeeded,
     Gap.unsupported Tm.explorationIsResearch,
     Gap.unsupported Tm.transformative] := by decide +kernel

/-- Denials of what nobody put forward: the excerpt's antitheses. -/
theorem antitheses_are : antitheses (run w0 moves) = [Tm.compromiseIdeas, Tm.colleaguesPL] := by decide +kernel

/-- Denials of what was put forward: contrasts. -/
theorem contrasts_are : contrasts (run w0 moves) = [Tm.applicationsMatter, Tm.llmsAffectEnthusiasm] := by decide +kernel

/-- Promises and contributions left for the rest of the paper. -/
theorem deferred_are : deferredList (run w0 moves) =
    [(Tm.crisis, 0), (Tm.juniorsWorry, 0), (Tm.counterfactualsFast, 0), (Tm.toolingPossible, 0), (Tm.loss, 0)] := by decide +kernel

/-- Without ego in the reader's background, a term is used before it is defined. -/
theorem lore_needed_ego : ¬ Valid (start (lore.erase Tm.ego) [0, 1, 2, 3]) moves := by decide +kernel

/-- Without exploration in the reader's background, a term is used before it is defined. -/
theorem lore_needed_exploration : ¬ Valid (start (lore.erase Tm.exploration) [0, 1, 2, 3]) moves := by decide +kernel


