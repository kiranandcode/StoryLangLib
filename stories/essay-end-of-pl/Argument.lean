   Move.claim Tm.workOnIdeas [Tm.pl_research],
   Move.deny Tm.compromiseIdeas [Tm.workOnIdeas],
   Move.claim Tm.practicalApps [Tm.pl_research]]

def p10 : List (Move Tm) :=
