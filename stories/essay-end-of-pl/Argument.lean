/-- Denials of what nobody put forward: the excerpt's antitheses. -/
theorem antitheses_are : antitheses (run w0 moves) = [Tm.compromiseIdeas, Tm.colleaguesPL] := by decide +kernel

/-- Denials of what was put forward: contrasts. -/
theorem contrasts_are : contrasts (run w0 moves) = [Tm.applicationsMatter, Tm.llmsAffectEnthusiasm] := by decide +kernel

/-- Promises and contributions left for the rest of the paper. -/
theorem deferred_are : deferredList (run w0 moves) =
    [(Tm.crisis, 0), (Tm.juniorsWorry, 0), (Tm.counterfactualsFast, 0), (Tm.toolingPossible, 0), (Tm.loss, 0)] := by decide +kernel

/-- Without ego in the reader's background, a term is used before it is defined. -/
theorem lore_needed_ego : ¬ Valid (start (lore.erase Tm.ego) [0, 1, 2, 3]) moves := by decide +kernel

/-- Without exploration in the reader's background, a term is used before it is defined. -/
theorem lore_needed_exploration : ¬ Valid (start (lore.erase Tm.exploration) [0, 1, 2, 3]) moves := by decide +kernel

