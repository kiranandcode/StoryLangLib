entity authors group they "I (the author)"
entity ai_tools abstract they "LLMs" generic
entity domains abstract they "these applied domains (the three projects)" of=para:17,para:18,para:19
entity theory abstract it "theoretical work"
entity counterfactuals abstract they "counterfactuals"
entity my_language abstract it "my language (a calculus under study)"
entity construct abstract it "this construct"
entity type_system abstract it "my type system"
topic t1 "theory too" theory
(S%t1 (PP.obl Alongside/ADP.case (NP.head@domains these/DET.det applied/ADJ.amod domains/NOUN.head=domain)) ,/PUNCT
  (NP.nsubj@ai_tools LLMs/NOUN.head=LLM)
  (VP.head are/AUX.cop=be{Fin,Pres} extremely/ADV.advmod~degree exciting/ADJ.head
    (PP.obl for/ADP.case (NP.head@theory theoretical/ADJ.amod work/NOUN.head)) too/ADV.advmod~degree)
  ./PUNCT)
(S%t1 (VP.csubj Being/AUX.cop=be{Ger} able/ADJ.head
    (VP.xcomp to/PART.mark automate/VERB.head{Inf} (NP.obj the/DET.det effort/NOUN.head~abstract (PP.nmod of/ADP.case proof/NOUN.compound~abstract writing/NOUN.head~event))))
  (VP.head makes/VERB.head=make{Fin,Pres} it/PRON.expl extremely/ADV.advmod~degree easy/ADJ.xcomp
    (VP.xcomp to/PART.mark ask/VERB.head{Inf} (NP.obj@counterfactuals counterfactuals/NOUN.head=counterfactual)))
  ./PUNCT)
(FRAG%t1 What/PRON.head
  (SBAR.advcl if/SCONJ.mark (S.head I/PRON.nsubj@authors
    (VP.head add/VERB.head{Fin,Pres} (NP.obj@construct this/DET.det construct/NOUN.head)
      (PP.obl to/ADP.case (NP.head@my_language my/PRON.poss@authors language/NOUN.head)))))
  ?/PUNCT)
(S%t1 is/AUX.cop=be{Fin,Pres} it/PRON.nsubj@my_language still/ADV.advmod~aspect strongly/ADV.advmod~degree normalising/ADJ.head ?/PUNCT)
(FRAG%t1 what/PRON.head
  (SBAR.advcl if/SCONJ.mark (S.head I/PRON.nsubj@authors
    (VP.head change/VERB.head{Fin,Pres} (NP.obj@type_system my/PRON.poss@authors type/NOUN.compound~abstract system/NOUN.head)
      (PP.obl like/ADP.case this/PRON.head~abstract))))
  ?/PUNCT)
(S%t1 is/AUX.cop=be{Fin,Pres} it/PRON.nsubj@type_system still/ADV.advmod~aspect sound/ADJ.head ?/PUNCT)
(S%t1 I/PRON.nsubj@authors
  (VP.head am/AUX.cop=be{Fin,Pres} now/ADV.advmod~time able/ADJ.head~impression
    (VP.xcomp to/PART.mark iterate/VERB.head{Inf}
      (PP.obl at/ADP.case (NP.head a/DET.det pace/NOUN.head~abstract
        (S.relcl I/PRON.nsubj@authors (VP.head have/AUX.aux{Fin,Pres} never/ADV.advmod been/AUX.cop=be{Part} able/ADJ.head~impression
          (VP.xcomp to/PART.mark do/VERB.head{Inf}) before/ADV.advmod~time))))))
  ./PUNCT)
