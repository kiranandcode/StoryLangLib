entity elements abstract it "the list of elements to be inserted"
entity independence_arg abstract it "this independence argument"
entity hash_invocations abstract they "all the hash invocations"
entity authors group they "we (the authors and reader)"
entity unset_prob abstract it "the probability that the selected bit is not raised during the execution, (1 - 1/m)^(kn)"
entity selected_bit abstract it "our selected bit b1"
entity execution abstract it "the execution (all the insertions)"
topic t1 "the bit stays unset over all insertions" unset_prob
(S%t1 (PP.obl In/ADP.case fact/NOUN.head~abstract) ,/PUNCT
  (SBAR.advcl provided/SCONJ.mark that/SCONJ.fixed
    (S.head (NP.nsubj@elements the/DET.det list/NOUN.head~abstract (PP.nmod of/ADP.case elements/NOUN.head=element~abstract
        (VP.acl to/PART.mark be/AUX.aux{Inf} inserted/VERB.head=insert{Part})))
      is/AUX.cop=be{Fin,Pres} unique/ADJ.head))
  ,/PUNCT
  (NP.nsubj@independence_arg this/DET.det independence/NOUN.compound~abstract argument/NOUN.head)
  (VP.head actually/ADV.advmod~degree generalises/VERB.head=generalise{Fin,Pres}
    (PP.obl over/ADP.case (NP.head@hash_invocations all/DET.det the/DET.det hash/NOUN.compound invocations/NOUN.head=invocation)))
  ,/PUNCT
  (S.conj and/CCONJ.cc thus/ADV.advmod~order (NP.nsubj@authors we/PRON.head)
    (VP.head can/AUX.aux{Fin,Pres} conclude/VERB.head{Inf}
      (SBAR.ccomp that/SCONJ.mark
        (S.head
          (NP.nsubj@unset_prob the/DET.det probability/NOUN.head
            (SBAR.acl that/SCONJ.mark
              (S.head (NP.nsubj@selected_bit our/PRON.poss@authors selected/ADJ.amod bit/NOUN.head)
                (VP.head is/AUX.aux=be{Fin,Pres} not/PART.advmod raised/VERB.head=raise{Part}
                  (PP.obl during/ADP.case (NP.head@execution the/DET.det execution/NOUN.head))))))
          (VP.head will/AUX.aux{Fin,Pres} be/AUX.cop{Inf}
            (NP.head@unset_prob \(/PUNCT 1/NUM.head -/SYM.cc (NP.conj 1/NUM.head //SYM.case m/SYM.nmod) \)/PUNCT ^/SYM.dep \(/PUNCT kn/SYM.dep \)/PUNCT))))))
  ./PUNCT)
