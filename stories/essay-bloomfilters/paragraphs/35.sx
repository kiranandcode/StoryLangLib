entity bits abstract they "the bits a query checks"
entity false_positive abstract it "this: a false positive occurring"
entity cited_expression abstract it "(1 - (1 - 1/m)^(kn))^k, Bloom's bound"
entity blooms_analysis abstract it "the proof (Bloom's analysis)"
topic t1 "Bloom's bound" cited_expression
(S%t1 Thus/ADV.advmod~order ,/PUNCT
  (PP.obl in/ADP.case the/DET.det case/NOUN.head~abstract
    (SBAR.acl that/SCONJ.mark (S.head (NP.nsubj@bits the/DET.det bits/NOUN.head=bit) are/AUX.cop=be{Fin,Pres} independent/ADJ.head)))
  ,/PUNCT
  (NP.nsubj@cited_expression the/DET.det probability/NOUN.head
    (SBAR.acl that/SCONJ.mark (S.head this/PRON.nsubj@false_positive will/AUX.aux{Fin,Pres} occur/VERB.head{Inf})))
  is/AUX.cop=be{Fin,Pres} simply/ADV.advmod~degree
  (NP.head@cited_expression \(/PUNCT 1/NUM.head -/SYM.cc
    (NP.conj \(/PUNCT 1/NUM.head -/SYM.cc (NP.conj 1/NUM.head //SYM.case m/SYM.nmod) \)/PUNCT ^/SYM.dep \(/PUNCT kn/SYM.dep \)/PUNCT)
    \)/PUNCT ^/SYM.dep k/SYM.dep)
  ,/PUNCT
  (VP.advcl thereby/ADV.advmod~manner concluding/VERB.head=conclude{Ger} (NP.obj@blooms_analysis the/DET.det proof/NOUN.head))
  ./PUNCT)
