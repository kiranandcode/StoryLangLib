entity authors group they "we, the authors"
entity bose group they "Bose et al."
entity critics group they "other researchers"
entity bose_expression abstract it "this new expression for the false positive rate"
entity fpr abstract it "the false positive rate"
entity bose_pub abstract it "Bose et al.'s publication"
entity errors abstract they "errors in Bose et al.'s derivation"
entity bose_derivation abstract it "Bose et al.'s derivation"
entity doubt abstract it "further doubt on its validity"
topic t1 "errors in Bose et al." critics,bose_derivation
(S%t1 Unfortunately/ADV.advmod~impression ,/PUNCT
  (SBAR.advcl while/SCONJ.mark
    (S.head (NP.nsubj@authors we/PRON.head)
      (VP.head now/ADV.advmod~time know/VERB.head{Fin,Pres}
        (SBAR.ccomp that/SCONJ.mark
          (S.head (NP.nsubj@bose_expression this/DET.det new/ADJ.amod expression/NOUN.head
                    (PP.nmod for/ADP.case (NP.head@fpr the/DET.det false/ADJ.amod positive/ADJ.amod rate/NOUN.head)))
            (VP.head is/AUX.cop=be{Fin,Pres} correct/ADJ.head))))))
  ,/PUNCT
  (NP.obl 2/NUM.nummod years/NOUN.head=year~time
    (PP.nmod after/ADP.case (NP.head@bose_pub (NP.nmod@bose Bose/PROPN.head et/X.flat al/X.flat ./PUNCT '/PUNCT s/PART.case) publication/NOUN.head)))
  ,/PUNCT
  (NP.nsubj@critics other/ADJ.amod~impression researchers/NOUN.head=researcher)
  (VP.head actually/ADV.advmod~degree found/VERB.head=find{Fin,Past}
    (NP.obj@errors errors/NOUN.head=error)
    (PP.obl in/ADP.case (NP.head@bose_derivation their/PRON.nmod@bose derivation/NOUN.head))
    ,/PUNCT
    (VP.advcl throwing/VERB.head=throw{Ger}
      (NP.obj@doubt further/ADJ.amod doubt/NOUN.head)
      (PP.obl on/ADP.case (NP.head its/PRON.nmod@bose_derivation validity/NOUN.head~abstract))))
  ./PUNCT)
