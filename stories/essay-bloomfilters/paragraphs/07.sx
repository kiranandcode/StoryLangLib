entity proxy abstract it "this mechanism: the local-proxy technique"
entity bloom_filter abstract it "a Bloom filter" generic
entity no_false_negatives abstract it "the No false negatives property"
entity low_fpr abstract it "the Low false positive rate property"
entity guarantees abstract they "the guarantees of a Bloom filter" of=no_false_negatives,low_fpr
entity safe_browsing abstract it "this particular task"
entity problem abstract it "one small problem: the cited expression is wrong"
entity cited_expression abstract it "the widely cited expression for the false positive rate"
entity fpr abstract it "the false positive rate of a Bloom filter"
topic t1 "the cited false positive rate is wrong" cited_expression,proxy
(S%t1
  (S.head (NP.nsubj@proxy This/DET.det mechanism/NOUN.head)
    (VP.head works/VERB.head=work{Fin,Pres} (ADVP.advmod quite/ADV.advmod~degree well/ADV.head~manner)))
  ,/PUNCT and/CCONJ.cc
  (S.conj (NP.nsubj@guarantees the/DET.det guarantees/NOUN.head=guarantee (PP.nmod of/ADP.case (NP.head@bloom_filter a/DET.det Bloom/PROPN.compound filter/NOUN.head)))
    (VP.head seem/VERB.head{Fin,Pres}
      (VP.xcomp to/PART.mark be/AUX.cop{Inf} perfectly/ADV.advmod~degree suited/ADJ.head
        (PP.obl for/ADP.case (NP.head@safe_browsing this/DET.det particular/ADJ.amod task/NOUN.head)))))
  ,/PUNCT
  (S.conj however/ADV.advmod~order it/PRON.nsubj@proxy
    (VP.head has/VERB.head=have{Fin,Pres} (NP.obj@problem one/NUM.nummod small/ADJ.amod problem/NOUN.head)))
  ,/PUNCT and/CCONJ.cc
  (S.conj that/PRON.nsubj@problem
    (VP.head is/VERB.head=be{Fin,Pres}
      :/PUNCT
      (S.ccomp
        (NP.nsubj@cited_expression The/DET.det (ADJP.amod widely/ADV.advmod~degree cited/ADJ.head) expression/NOUN.head
          (PP.nmod for/ADP.case (NP.head@fpr the/DET.det false/ADJ.amod positive/ADJ.amod rate/NOUN.head
            (PP.nmod of/ADP.case (NP.head@bloom_filter a/DET.det bloom/NOUN.compound filter/NOUN.head)))))
        (VP.head is/AUX.cop=be{Fin,Pres} wrong/ADJ.head))))
  !/PUNCT)
